{
  "name": "wagering-processor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run src/main.ts",
    "dev": "bun --watch run src/main.ts",
    "typecheck": "tsc --noEmit",
    "migration:up": "bun run src/infrastructure/persistence/migrate.ts up",
    "migration:down": "bun run src/infrastructure/persistence/migrate.ts down",
    "migration:reset": "bun run src/infrastructure/persistence/migrate.ts reset",
    "test": "bun test --timeout 60000",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test --timeout 60000 test/integration",
    "test:concurrency": "bun test --timeout 60000 test/concurrency",
    "test:multi": "bun run scripts/test-multi.ts",
    "test:all": "bun run test && bun run test:multi",
    "infra:up": "docker compose up -d postgres localstack migrate sqs-init",
    "stack:up": "docker compose up -d --build",
    "queues:provision": "bun run src/infrastructure/messaging/sqs/provision-queues.ts",
    "infra:down": "docker compose down -v"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1144.0",
    "@mikro-orm/core": "7.2.3",
    "@mikro-orm/migrations": "7.2.3",
    "@mikro-orm/nestjs": "7.1.0",
    "@mikro-orm/postgresql": "7.2.3",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "decimal.js": "10.6.0",
    "pino": "10.3.1",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.2",
    "@types/bun": "1.4.2",
    "@types/express": "5.0.6",
    "typescript": "7.0.2"
  }
}
